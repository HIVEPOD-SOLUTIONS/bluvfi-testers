# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
# Stage 1 — build
# Installs full deps, generates Prisma client, compiles TypeScript to dist/.
# ---------------------------------------------------------------------------
    FROM node:20-alpine AS builder
    WORKDIR /app/backend
    ENV CI=true
    
    # Prisma query engine and some git-dependent deps need these
    RUN apk add --no-cache openssl git
    
    # Copy backend package files (matching your CI workflow)
    COPY backend/package.json backend/package-lock.json ./
    RUN npm ci
    
    # Copy prisma schema and generate client
    COPY backend/prisma ./prisma
    RUN npx prisma generate
    
    # Copy source (this includes src/tsconfig.json) and build
    COPY backend/src ./src
    RUN npm run build
    
    # ---------------------------------------------------------------------------
    # Stage 2 — production runtime
    # Prod-only deps + prisma CLI for `prisma migrate deploy`
    # ---------------------------------------------------------------------------
    FROM node:20-alpine AS runner
    WORKDIR /app/backend
    ENV NODE_ENV=production
    ENV PORT=3001
    
    RUN apk add --no-cache openssl git
    
    # Copy backend package files and prisma schema
    COPY backend/package.json backend/package-lock.json ./
    COPY backend/prisma ./prisma
    
    # Install production dependencies strictly from lockfile, then add prisma CLI
    RUN npm ci --omit=dev \
     && npm install --no-save prisma@5.22.0 \
     && npx prisma generate
    
    # Copy built assets from builder stage
    COPY --from=builder /app/backend/dist ./dist
    
    EXPOSE 3001
    
    # Health check
    HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
      CMD wget -qO- http://127.0.0.1:3001/health >/dev/null 2>&1 || exit 1
    
    CMD ["node", "dist/index.js"]